# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud's
# "Secrets" box under App settings. Both keys are optional.

# Powers resume tailoring and cover-letter writing. Without it the app still
# does job search, scoring, gap analysis, and the cover-letter scaffold.
# Users can also paste their own key into the sidebar at runtime.
ANTHROPIC_API_KEY = "sk-ant-..."

# Free keys from https://developer.adzuna.com — enables nationwide US job
# aggregation. Without them the Adzuna source is skipped.
ADZUNA_APP_ID = ""
ADZUNA_APP_KEY = ""
