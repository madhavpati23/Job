# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud's
# "Secrets" box under App settings. Everything here is optional.

# --- AI writing (pick ONE provider) ---------------------------------------
# Powers resume tailoring and cover-letter writing. Without any of these the
# app still does job search, scoring, gap analysis, and the letter scaffold.
# Users can also choose a provider and paste their own key in the sidebar.

ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY   = "sk-..."
# GOOGLE_API_KEY   = "AIza..."
# LLM_API_KEY      = ""   # any OpenAI-compatible endpoint (set base URL in the UI)

# --- Job sources ----------------------------------------------------------
# Free keys from https://developer.adzuna.com — enables nationwide US job
# aggregation. Without them the Adzuna source is skipped.
ADZUNA_APP_ID = ""
ADZUNA_APP_KEY = ""

# Free key from https://developer.usajobs.gov — adds US federal jobs.
# USAJOBS_EMAIL   = "the email you registered with"
# USAJOBS_API_KEY = ""

# --- Optional server-side tracker storage ---------------------------------
# Off by default: the app stores nothing server-side and the tracker lives in
# the browser session. Set to "true" to let users opt into saving their
# tracker under a private random token carried in the URL.
# On Streamlit Community Cloud the disk is ephemeral (wiped on redeploy and
# when the app sleeps) — point TRACKER_DB at a persistent volume for durability.
# TRACKER_STORAGE = "true"
# TRACKER_DB      = "/mnt/data/tracker.db"
